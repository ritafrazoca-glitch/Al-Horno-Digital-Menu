rules_version = '2';
// Al'Horno: o site já não usa o Firestore.
// Estas regras bloqueiam qualquer leitura/escrita pública.
// Publicar na consola do Firebase: Firestore Database → Regras → colar → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
